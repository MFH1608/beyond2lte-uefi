/dts-v1/;

/ {

/*
 * UYARI: BU DOSYA YER TUTUCUDUR (PLACEHOLDER) - GERCEK S10e DTB'SI DEGIL.
 *
 * build_uefi.py, boot imajina Resources/DTBs/beyond0lte.dtb ekler
 * (append_dtb = true) ve dosya yoksa derleme durur. Gercek S10e DTB'si
 * henuz stock firmware'den / cihazdan cikarilmadi.
 *
 * Bu dosya beyond2lte'nin birlesik DTB'sinden uretildi; yalnizca "model"
 * satiri degistirildi. UEFI bu DTB'yi CALISMA ZAMANINDA KULLANMIYOR
 * (FDF'de DtPlatformDxe yorumda), yani acilisi etkilemez. Ama icindeki
 * reserved-memory ve board revizyon bilgileri S10e'ye ait DEGILDIR ve
 * tools_reserved_memory_audit.py'nin ciktisi bu yuzden yaniltici olur.
 *
 * Gercek DTB:  bash tools_dtb_s10e.sh   (bkz. PORT_S10E.md, Bolum 2)
 */
	model = "Samsung BEYOND0LTE EUR OPEN 26 board based on EXYNOS9820";
	compatible = "samsung,armv8\0samsung,exynos9820";
	dtb-hw_rev = <0x00>;
	dtb-hw_rev_end = <0xff>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x01>;

	shmem {
		phandle = <0x372>;
		linux,phandle = <0x372>;
		shmem,vparam_size = <0x200000>;
		shmem,vparam_offset = "\vp\0";
		shmem,zmb_size = <0x00>;
		shmem,zmb_offset = <0x00>;
		shmem,ipc_size = <0x500000>;
		shmem,ipc_offset = "\v \0";
		shmem,l2b_size = <0x3200000>;
		shmem,l2b_offset = <0x8000000>;
		shmem,vss_size = <0x800000>;
		shmem,vss_offset = <0x7800000>;
		shmem,cp_size = <0x7800000>;
		compatible = "samsung,exynos-shm_ipc";
	};

	mailbox_cp {
		phandle = <0x371>;
		linux,phandle = <0x371>;
		mcu,irq_affinity_mask = <0x03>;
		interrupts = <0x00 0x29 0x00>;
		mcu,id = <0x00>;
		mcu,name = "mcu_ipc_cp";
		reg = <0x00 0x15920000 0x180>;
		compatible = "samsung,exynos-shd-ipc-mailbox";
	};

	mif_pdata {
		phandle = <0x370>;
		linux,phandle = <0x370>;
		mif,num_iodevs = <0x16>;
		sbi_ap2cp_kerneltime_usec_pos = <0x00>;
		sbi_ap2cp_kerneltime_usec_mask = <0xfffff>;
		sbi_ap2cp_kerneltime_sec_pos = <0x14>;
		sbi_ap2cp_kerneltime_sec_mask = <0xfff>;
		sbi_cp_status_pos = <0x01>;
		sbi_cp_status_mask = <0x0f>;
		sbi_lte_active_pos = <0x05>;
		sbi_lte_active_mask = <0x01>;
		sbi_cp2ap_wakelock_pos = <0x06>;
		sbi_cp2ap_wakelock_mask = <0x01>;
		sbi_cp_evs_mode_pos = <0x07>;
		sbi_cp_evs_mode_mask = <0x01>;
		sbi_cp_rat_mode_pos = <0x1a>;
		sbi_cp_rat_mode_mask = <0x3f>;
		sbi_ap_status_pos = <0x01>;
		sbi_ap_status_mask = <0x0f>;
		sbi_pda_active_pos = <0x05>;
		sbi_pda_active_mask = <0x01>;
		sbi_sys_rev_pos = <0x06>;
		sbi_sys_rev_mask = <0xff>;
		sbi_ds_det_pos = <0x0e>;
		sbi_ds_det_mask = <0x03>;
		sbi_ext_backtrace_pos = <0x11>;
		sbi_ext_backtrace_mask = <0x01>;
		sbi_device_type_pos = <0x12>;
		sbi_device_type_mask = <0x1f>;
		sbi_crash_type_pos = <0x17>;
		sbi_crash_type_mask = <0x0f>;
		mbx_ap2cp_kerneltime = <0x09>;
		mbx_cp2ap_dvfsreq_int = <0x07>;
		mbx_cp2ap_dvfsreq_mif = <0x06>;
		mbx_cp2ap_dvfsreq_cpu = <0x05>;
		mbx_cp2ap_united_status = <0x03>;
		mbx_ap2cp_united_status = <0x02>;
		mbx_cp2ap_msg = <0x01>;
		mbx_ap2cp_msg = <0x00>;
		mif,irq_cp2ap_ratmode = <0x09>;
		mif,irq_cp2ap_wakelock = <0x08>;
		mif,irq_cp2ap_perf_req_int = <0x07>;
		mif,irq_cp2ap_perf_req_mif = <0x06>;
		mif,irq_cp2ap_perf_req_cpu = <0x05>;
		mif,irq_cp2ap_active = <0x03>;
		mif,irq_cp2ap_status = <0x02>;
		mif,irq_cp2ap_msg = <0x00>;
		mif,int_ap2cp_active = <0x03>;
		mif,int_ap2cp_status = <0x02>;
		mif,int_ap2cp_wakeup = <0x01>;
		mif,int_ap2cp_msg = <0x00>;
		mif,link_attrs = <0x7c9>;
		mif,link_name = "shmem";
		mif,link_types = <0x200>;
		mif,ipc_version = <0x32>;
		mif,use_handover = <0x00>;
		mif,modem_type = <0x0b>;
		mif,modem_net = <0x00>;
		mif,name = "s5000ap";
		ap2cp_cfg_addr = <0x15020000>;
		interrupt-names = "CP2AP_WAKEUP\0DIT_BUS_ERR\0DIT_RX_DONE\0DIT_TX_DONE";
		interrupts = <0x00 0x177 0x00 0x00 0x44 0x00 0x00 0x43 0x00 0x00 0x42 0x00>;
		pinctrl-names = "default";
		gpios = <0x8b 0x04 0x00 0x8b 0x03 0x00 0x8b 0x02 0x00 0x8b 0x01 0x00 0x91 0x05 0x00 0x91 0x04 0x00 0x91 0x03 0x00 0x91 0x02 0x00>;
		status = "okay";
		compatible = "sec_modem,modem_pdata";
		reg-names = "offset\0dit\0sysreg_busc";
		reg = <0x00 0x10000 0x00 0x00 0x1a2a0000 0x10000 0x00 0x1a220000 0x2000>;

		iodevs {

			io_device_21 {
				iod,option_region = "usa_spr";
