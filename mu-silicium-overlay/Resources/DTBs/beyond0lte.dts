			sfr-dump-gic-setenable {
				reg = <0x10101100 0x100>;
				addr = <0x10101100 0x10101104 0x10101108 0x1010110c 0x10101110 0x10101114 0x10101118 0x1010111c 0x10101120 0x10101124 0x10101128 0x1010112c 0x10101130 0x10101134 0x10101138 0x1010113c 0xffffffff>;
